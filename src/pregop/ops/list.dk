#include "dkli.dkh"
#!
module ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "config.dk"
    #include "../config.dk"
	#include "../_lib/lib.dk"
    #include "uielements.v12.dkl"
    #include "dbr.dkh"

    do @context.begin(@crud_context)

    ref selects=@("&./selects")
    ref first_select=@item(selects,0)
    ref list_filter=@("&./list_filter")
    ref @qry_links=@("&./qry_links")

    new select
    {
        @"datatable*":selects
        @"id":"dte"
        member "attributes"
        {
            @"class":"induxsoft-form-select"
            @"name":"dte"
        }
        @"value_field":"dte"
        @"text_field":"text"
        @"selected":@("$parameters/dte")
    }

    new select_filter
    {
        @"datatable*":list_filter
        @"id":"selectfilter"
        member "attributes"
        {
            @"class":"induxsoft-form-select"
            @"name":"selectfilter"
        }
        @"value_field":"key"
        @"text_field":"value"
        @"selected":@("$parameters/selectfilter")
    }

    ref data=@("&./data")

    ref @first_row=@item(data,0)
    @dte=@@(first_select,"$dte")
    if @("$parameters/dte")!=""{@dte=@("$parameters/dte")}

    @url_current=current_url(@false)
    @url_current_encode=url_encode(@url_current)
    print_table::
    {
        ref columns=list.create_from_fields(ifnull(@first_row,record.create()))
        ref dte_selected=@("&./dte_selected")
        ref data=@("&./data")

        #$
        table(class="table")
        {
            thead(class="bg-white")
            {
                tr
                {
                    th{""}
                    #!
                    for i = 0; i <@count(columns)
                    {
                        column=list.str(columns,i)
                        if not(contains(column,"sys")) || (column==@@(dte_selected,"$max_field") || column==@@(dte_selected,"$ref_field")|| column==@@(dte_selected,"$key_show")|| column==@@(dte_selected,"$show_text")|| column==@@(dte_selected,"$info_text") )
                        {
                            #$ th(class="capitalize"){"#<column>"}
                        }
                    }
                }
            }
            tbody
            {$""
                #!
                if @count(data) <1
                {
                    #$
                    tr
                    {
                        td(class="text-center"){b{"NO HAY DATOS DISPONIBLES PARA MOSTRAR"}}
                    }
                    #!
                }
                for j = 0; j <@count(data)
                {
                    ref dt=@item(data,j)
                    url=replace(@OPS_OPER_GOP,"{id}",@@(dt,"$sys_pk")) + "?dte="+@dte
                   #$ tr
                   {
                        td
                        {$""
                            #!
                            if @("#parameters/selectfilter")==2 || @("#parameters/selectfilter")==99
                            {
                                #$
                                button(class="btn btn-sm induxsoft-corners border" onclick="ops.Back(#<@@(dt,'#sys_pk')>)" title="Regresar a por afectar")
                                {
                                    $'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" fill="currentColor" class="bi bi-arrow-90deg-left" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M1.146 4.854a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 4H12.5A2.5 2.5 0 0 1 15 6.5v8a.5.5 0 0 1-1 0v-8A1.5 1.5 0 0 0 12.5 5H2.707l3.147 3.146a.5.5 0 1 1-.708.708z"/>
                                        </svg>'
                                }
                                #!
                            }
                            else 
                            {
                                #$
                                a(class="btn btn-sm induxsoft-corners border" href="#<url>" title="Ir a movimientos")
                                {
                                    $'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-lg" viewBox="0 0 16 16">
                                    <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z"/>
                                    </svg>'
                                }
                                button(class="btn btn-sm induxsoft-corners border ms-1" onclick="ops.descartar(#<@@(dt,'#sys_pk')>)" title="Descartar")
                                {
                                    $'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                                        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                                        </svg>'
                                }
                            }
                            
                        }
                        #! 
                        for i = 0; i <@count(columns)
                        {
                            column=list.str(columns,i)
                            if not(contains(column,"sys")) || (column==@@(dte_selected,"$max_field") || column==@@(dte_selected,"$ref_field") || column==@@(dte_selected,"$key_show")|| column==@@(dte_selected,"$show_text")|| column==@@(dte_selected,"$info_text") )
                            {
                                field=@@(dt,'$'+column)
                                class=""

                                if parse.num(field)>0 && field.typeof(dt,column)==2 //si es numero
                                {
                                    class="text-end"
                                    field=format(parse.num(field),@FORMAT_DET_PRES)
                                }
                                #$ 
                                td(class="#<class>")
                                {
                                    #!
                                    link=@@(@qry_links,"$"+column+"/link")
                                    if trim(link)!=""
                                    {
                                        link=replace(link,"{","#<@@(dt,'$")
                                        link=replace(link,"}","')>")
                                        
                                        if contains(link,"?"){link=link+"&_from_url_e="+@url_current_encode}
                                        else{link=link +"?_from_url_e="+@url_current_encode }

                                        #$
                                        a(href="#<ftext(link)>"){"#<field>"}
                                        #!
                                    }
                                    else 
                                    {
                                        #$
                                        span{"#<field>"}
                                    }
                                }
                            }
                            
                        }
                   } 
                }
            }
        }
        
        #!
    }
    
    #$
    div(class="container-fluid v12-list-view" id="view")
    {
        script(src="#<@JS_OPS>"){""}
        section(id="top_area")
        {
            #!
            do uie.printMainBar(@null,"Operaciones",@false,"")
            #$ 
            form(method="GET" action="." id="form_search")
            {
                div(class="row gy-1 gx-1")
                {
                    div(class="col-md-2 col-lg-3") //operacion filter
                    {$""
                        #!
                        do uie.dbSelect(select)
                        #$
                    }
                    div(class="col-md-2 col-lg-3") //status filter
                    {$""
                        #!
                        if @count(list_filter) > 0
                        {
                            #!
                            do uie.dbSelect(select_filter)
                            #$
                        }
                    }
                    div(class="col-md-8 col-lg-6") //date filter
                    {
                        "date-range"("hidden-input-name-start"="startdate" "hidden-input-name-end"="enddate" id="datefilter" start="#<@('$parameters/startdate')>" end="#<@('$parameters/enddate')>"){""}
                    }
                    div(class="col-md-12") //text filter
                    {
                        "filter-text"(
                                "id"="text"
                                "text-field"="text"
                                "placeholder"="Buscar ..."
                                "form"="#form_search"
                                "value"="#<@('$parameters/text')>"
                                "auto-submit"="true"
                                "class"="w-100"
                            ){$""}
                    }
                }
            }
        }
        section(id="work_area")
        {
            div(class="table-responsive h-100")
            {
                #!
                do print_table()
                #$
            }
        }
        
        script
        {
            $'
            
            var dte=document.getElementById("dte");
            var selectfilter=document.getElementById("selectfilter");
            var form=document.getElementById("form_search");
            if(dte)dte.addEventListener("change",(e)=>{if(form)form.submit();});
            if(selectfilter)selectfilter.addEventListener("change",()=>{if(form)form.submit();});
            

            document.addEventListener("DOMContentLoaded",(e)=>
            {
                var datefilter=document.getElementById("datefilter");
                if(datefilter._btnDone)datefilter._btnDone.addEventListener("click",()=>
                {
                    setTimeout(()=>{if(form)form.submit();},300)
                });
            });
            

            ops.url_descartar="#<@OPS_EDIT>";
            '
        }
        style
        {
            $'
                .capitalize
                {
                    text-transform: capitalize;
                }
                thead 
                {
                    position: sticky;
                    top: 0;
                    z-index: 15;
                }
            '
        }
    }
    
    
}