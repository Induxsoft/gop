#include "dkli.dkh"
#!
module ""
{
    #include "pregop/pregop.dkh"

    @list_query_gop_mov="SELECT gm.sys_pk,gp.sys_pk pkpartida,u.descripcion uorg, u.sys_pk pkuorg,
    gp.partida,gm.periodo,gm.comprometido,gm.ejercido,gm.referencia,p.ejercicio,gm.dte,gm.dte_id
    FROM gop_mov gm
    INNER JOIN gop_partida gp ON gm.ref_partida=gp.sys_pk
    INNER JOIN gop_presupuesto p ON gp.ref_presupuesto=p.sys_pk
    INNER JOIN rh_unidad_org u ON p.ref_unidad=u.sys_pk
    WHERE gm.dte=@dte AND gm.dte_id=@dte_id and p.ejercicio=@ejercicio"

    getEjercicio::&db
    {
        ref years=dbr.rec(db,"SELECT YEAR(NOW())current_year,year(DATE_ADD(NOW(),interval "+str(@NUM_EJERCICIO )+" YEAR))last_year,year(DATE_ADD(NOW(),INTERVAL -"+str(@NUM_EJERCICIO )+" YEAR))before_year",@null)
        current_year=@@(years,"#current_year")
        last_year=@@(years,"#last_year")
        before_year=@@(years,"#before_year")

        ref l=list.create()

        for i = before_year; i < current_year 
        {
            new y
            {
                @"clave":i
                @"valor":i
            }
            do list.add(l,y)
        }
        for i = current_year; i <= last_year 
        {
            new y
            {
                @"clave":i
                @"valor":i
            }
            do list.add(l,y)
        }
        return l
    }
    prepareView::&db,&params,&entity
    {
        using entity
        {
            @"selects*":dbr.list(db,"SELECT * FROM gop_src gs ORDER BY gs.sys_pk desc",@null)
            @"ejercicios*":getEjercicio(db)
        }
    }
    GetQuery::&params,&select,&entity
    {
        using entity{@"dte_selected*":select}

        if trim(@@(select,"$data_filters"))!=""
        {
            ref data_filters=from.json(@@(select,"$data_filters"))
            ref queries=@@(data_filters,"&queries")
            sqlfilter=@@(queries,"$qry_"+trim(@@(params,"$selectfilter")))
            
            using entity
            {
                @"list_filter*":@@(data_filters,"&list_filter")
                @"qry_links*":@@(data_filters,"&qry_links")
            }
            
            if not(@@(params,"#filter")) && trim(sqlfilter)!=""
            {
                return ftext(sqlfilter)
            }
        }
        if @@(params,"#filter"){return @@(select,"$qry_select")}

        return @@(select,"$qry_pending")
    }
    GenListQuery::&params,&select_src,&entity
    {
        if @@(params,"$dte")==""{return GetQuery(params,@item(select_src,0),entity)}

        for i = 0; i < @count(select_src)
        {
            ref select=@item(select_src,i)
            if @@(select,"$dte")==@@(params,"$dte")
            {
                return GetQuery(params,select,entity)
            }
        }

        return ""
    }
    ValidateMargen::margen,importe_gt,importe_prd,_text
    {
        importe_min=importe_gt - margen
        importe_max=importe_gt + margen
        
        if importe_prd < importe_min{do rise_error(500,"El importe está debajo del margen mínimo aceptable"+_text)}
        else if importe_prd > importe_max{do rise_error(500,"El importe total está arriba del margen aceptable"+_text)}
    }
    save::&db,&params,&data
    {
        ref entity=@null
        name_table=getTable(params)
        
        switch @@(data,"$act")
        {
            case "delete_partida"
            {
                do dbr.execute(db,"delete from gop_mov where sys_pk=@sys_pk",data)
                return data
            }
            case "back_for_affect"
            {
                is_presupestado=dbr.num(db,ftext("select ifnull(presupuestado,-1) from #<name_table> where sys_pk=@_entity_id"),params)
                
                do dbr.apps.action.pre("GP22")
                do dbr.begin(db)
                
                if is_presupestado
                {
                    do dbr.apps.action.pre("GP23")
                    ref partidas=dbr.list(db,ftext("SELECT 
                                g.sys_pk,g.ref_partida,g.referencia,g.periodo,
                                g.comprometido,g.ejercido,g.dte,g.dte_id,g.usuario,
                                g.notas 
                                FROM gop_mov g
                                WHERE g.dte=@dte AND g.dte_id=@_entity_id"),params)
                    
                    if @count(partidas) < 1{do rise_error(500,"No se encontrarón partidas afectadas")} 

                        for i = 0; i < @count(partidas)
                        {
                            ref partida=@item(partidas,i)

                            comprometido=@@(partida,"#comprometido")
                            ejercido=@@(partida,"#ejercido")

                            if comprometido > 0 || ejercido > 0
                            {
                                new montos{}

                                if comprometido > 0{montos<"comprometido">:comprometido * -1}
                                if ejercido > 0{montos<"ejercido">:ejercido * -1}
                                do pregop.partida.afectar(db,@@(partida,"#ref_partida"),@@(partida,"#periodo"), montos )
                            }
                            do dbr.execute(db,"update gop_mov set sys_deleted=1 where sys_pk=@sys_pk",partida)
                        }
                        new table
                        {
                            @"presupuestado*":@null
                            @"sys_pk":@@(data,"#sys_pk")
                            @"sys_timestamp*":now()
                        }
                        do dbr.update(db,name_table,table,"sys_pk=@sys_pk",table)
                }
                else 
                {
                    new table
                    {
                        @"presupuestado*":@null
                        @"sys_pk":@@(data,"#sys_pk")
                        @"sys_timestamp*":now()
                    }
                    do dbr.update(db,name_table,table,"sys_pk=@sys_pk",table)
                }
                
                do dbr.apps.action.pos(data)
                do dbr.commit(db)
                do dbr.apps.action.ext(data)
                
                return data
            }
            case "descartar"
            {
                do dbr.apps.action.pre("GP21")
                do dbr.begin(db)
                
                    new table
                    {
                        @"presupuestado":0
                        @"sys_pk":@@(data,"#sys_pk")
                        @"sys_timestamp*":now()
                    }

                    do dbr.update(db,name_table,table,"sys_pk=@sys_pk",table)
                
                do dbr.apps.action.pos(table)
                do dbr.commit(db)
                do dbr.apps.action.ext(table)
                        
                return data
            }
            case "gop_mov"
            {
                do dbr.apps.action.pre("GP23")

                if trim(@@(data,"$txt_gop_mov"))==""{do rise_error(500,"No hay datos para insertar")}
                if trim(@@(data,"$txt_ref_gasto"))==""{do rise_error(500,"No hay datos de ref gasto")}

                ref partidas=from.json(@@(data,"$txt_gop_mov"))
                ref ref_gasto=from.json(@@(data,"$txt_ref_gasto"))
                
                params<"dte">:@@(ref_gasto,"$dte")
                params<"ejercicio">:@@(ref_gasto,"$ejercicio")

                if trim(name_table)==""{name_table=getTable(params)}
                
                ref data_tble=dbr.rec(db,ftext("select ifnull(presupuestado,0)presupuestado,total from #<name_table> where sys_pk=@_entity_id"),params)
                is_presupestado=@@(data_tble,"#presupuestado")
                
                
                do dbr.begin(db)
                    comprometido_total= 0
                    ejercido_total= 0

                    for i = 0; i < @count(partidas)
                    {
                        ref partida=@item(partidas,i)
                        comprometido=@@(partida,"#comprometido")
                        ejercido=@@(partida,"#ejercido")
                        
                        comprometido_total= comprometido_total + comprometido
                        ejercido_total= ejercido_total + ejercido

                        //convertir comprometido y ejercido a la divisa del presupueso
                        
                        if @@(partida,"#sys_pk") > 0
                        {
                            params<"pkmgop">:@@(partida,"#sys_pk")

                            new mp
                            {
                                @"comprometido":comprometido
                                @"ejercido":ejercido
                                @"periodo":@@(partida,"#periodo")
                                @"sys_deleted*":@null
                            }
                            
                            if not(is_presupestado)
                            {
                                if comprometido > 0 || ejercido > 0
                                {
                                    do pregop.partida.afectar(db,@@(partida,"#pkpartida"),@@(partida,"#periodo"), record.copy(mp,"*") )
                                }
                            }
                            
                            do dbr.update(db,"gop_mov",mp,"sys_pk=@pkmgop",params)
                        }
                        else 
                        {
                            using gop_mov
                            {
                                @"sys_pk":@@(partida,"#pkpartida")
                                @"referencia":@@(ref_gasto,"$referencia")
                                @"periodo":@@(partida,"#periodo")
                                @"det":@@(ref_gasto,"$dte")
                                @"det_id":@@(ref_gasto,"#sys_pk")
                                @"usuario":@@(@http_context,"$session/user/uid")
                                @"notas":@@(ref_gasto,"$concepto")
                                @"ejercicio":@@(ref_gasto,"$ejercicio")
                            }
                            
                            if comprometido> 0
                            {
                                gop_mov<"comprometido">:comprometido
                                res=pregop.partida.movimiento(db,gop_mov)
                            }

                            if ejercido > 0
                            {
                                do field.remove(gop_mov,"comprometido")
                                gop_mov<"ejercido">:ejercido
                                res=pregop.partida.movimiento(db,gop_mov)
                            }
                        }
                    }
                    
                    margen_minmax=parse.num(dbr.vars.get(db,"pregop_ops_margen_min_max"))
                    if comprometido_total > 0{do ValidateMargen(margen_minmax,@@(data_tble,"#total"),comprometido_total,", columna: comprometido")}
                    if ejercido_total > 0{do ValidateMargen(margen_minmax,@@(data_tble,"#total"),ejercido_total,", columna: ejercido")}
                    
                    new table
                    {
                        @"presupuestado":1
                        @"sys_pk":@@(ref_gasto,"#sys_pk")
                        @"sys_timestamp*":now()
                    }
                    do dbr.update(db,name_table,table,"sys_pk=@sys_pk",table)
                
                do dbr.apps.action.pos(table)
                do dbr.commit(db)
                do dbr.apps.action.ext(table)

                @url_redir=@OPS_OPER + "?dte="+@@(params,"$dte")
            }
            default
            {
                do rise_error(500,"Operación no implementado")
            }
        }
        
        return entity

        exception
        {
            error=last_error()
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do dbr.apps.action.log()
            do prepareView(db,params,data)
            do GenListQuery(params,@@(data,"&selects"),data)
            do rise_error(500,error)
        }
    }
    ConvertImporte::&db,partida,ejercido,comprometido
    {
        partida >> p
        ref presupueso=dbr.rec(db,"SELECT g.sys_pk,g.divisa,d.tcambio FROM gop_presupuesto g 
                            INNER JOIN divisa d ON g.divisa=d.sys_pk
                            INNER JOIN gop_partida p ON g.sys_pk=p.ref_presupuesto
                            WHERE p.sys_pk=@partida;",p)
        if isnull(presupueso){do rise_error(500,"No se encontró el presupuesto de la partida")}

        using p
        {
            @"ejercido":ejercido * @@(presupueso,"#tcambio")
            @"comprometido":comprometido * @@(presupueso,"#tcambio")
        }
        // do rise_error(0,to.json(p))
        return p   
    }

    list::&db,&params
    {
        do dbr.apps.action.grant("GP20")

        new entity{}
        do prepareView(db,params,entity)
        
        @list_query=GenListQuery(params,@@(entity,"&selects"),entity)
        
        if trim(@list_query)==""{return entity}

        using entity
        {
            @"data*":entity.list(db,params)
        }

       return entity
    }

    getTable::&params
    {
        table=""
        switch tolower(@@(params,"$dte"))
        {
            case "det024" //gastos
            {
                table="ut_gasto"
                break
            }
            case "det07a" //reeg
            {
                table="rhgf_ree"
            }
        }
        return table
    }
    PrepareParams::&params,&data
    {
        ref lkey=list.create_from_fields(ifnull(data,record.create()))
        for i = 0; i < @count(lkey)
        {
            key=list.str(lkey,i)
            params<tolower(key)>:@@(data,"$"+key)

            if trim(@@(params,"$filter_text"))=="" && (tolower(key) == "referencia" || tolower(key) == "sys_guid") 
            {
                params<"filter_text"> : @@(data,"$"+key)
            }
        }
    }
    read::&db,&params
    {
        do dbr.apps.action.grant("GP20")

        using params
        {
            @"filter":@true
        }
        
        table=getTable(params)
        params<"table"> : table
        
        ref data=dbr.rec(db,"select * from "+table+" where sys_pk=@_entity_id",params)
        
        if @@(params,"$ref_gasto")!=""{params<"filter_text">:@@(params,"$ref_gasto")}
        else{do PrepareParams(params,data)}

        ref entity= list(db,params)
        
        if @@(params,"#rgasto"){return @@(entity,"&data")}
        
        params<"dte_id">:@@(data,"#sys_pk")
        
        if @@(params,"$ejercicio")=="" && @@(params,"$txt_ejercicio")==""{params<"ejercicio">:date_str(now(),"yyyy")}
        else if @@(params,"$txt_ejercicio")!=""{params<"ejercicio">:@@(params,"$txt_ejercicio")}
        

        ref gop_movs=dbr.list(db,ftext(@list_query_gop_mov),params)
        do periodo(gop_movs)

        using entity{@"gop_movs*":gop_movs}
        return entity
    }
    periodo::&l
    {
        for i = 0; i < @count(l)
        {
            ref itm=@item(l,i)  
            itm<"fperiodo">:getMes(@@(itm,"#periodo"))
        }
    }
    
    point @read to read
    point @create to save
    point @update to save
    point @list to list
}