#include "dkli.dkh"
#!
program
{
    #include "functions.dkh"
	#include "serialize.dkh"
	#include "webcl.dkh"
	//#include "website.dkl"
    #include "../config.dk"
	#include "lib.dk"
	#include "../_lib/icons.dk"

	do @context.begin(@crud_context)

	ref unidades = @('&./unidades')
	ref stts = @('&./status')
	ref dvss = @('&./divisas')
	ref dvsp = @('&./dvspred')
	
	current_year = get_current_year()
	message_pvg = @("$parameters/message_pvg")

	if trim(message_pvg)!="" {
		@TEMPLATE_ADD=replace(@TEMPLATE_ERROR_PVG,"@message",message_pvg)
	}

    #$ 
	div
	{
		#! 
		#include "./modals.dk"
		#$

		link(rel="stylesheet" href="#<@CSS_MAIN>")
		link(rel="stylesheet" href="#<@CSS_EDITOR>")

		div(id="main_container")
		{
			// Panel izquierdo
			div(id="unidades_container" class="section-container bg-white")
			{
				div
				{
					// Barra de controles
					div(class="d-flex flex-wrap justify-content-between border-bottom")
					{
						div(id="btn_hidde_unidad_panel")
						{
							button(onclick="editor.toggleTabUnidades()" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow"){
								svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#000" class="bi bi-list" viewBox="0 0 16 16"){
									path("fill-rule"="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5")
								}
								small{$""}
							}
						}
						div(class="d-flex flex-wrap justify-content-end flex-grow-1" id="unidad_controls")
						{
							button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control" title="Editar unidad" "data-bs-toggle"="modal" "data-bs-target"="#modal_add_unidades" id="btn_edit_unidad"){$"#<@ICON_EDIT>"}
							button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" title="Agregar unidad" "data-bs-toggle"="modal" "data-bs-target"="#modal_add_unidades" id="btn_add_unidad"){$"#<@ICON_PLUS_LG>"}
							button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow" title="Eliminar unidad" onclick="editor.deleteUnidadSelected()" id="btn_delete_unidad"){$"#<@ICON_TRASH>"}
						}
					}
					// Lista de unidades
					div(id="unidades_container_list")
					{
						div(style="max-height: 90vh;display: flex;")
						{
							"edit-table"(id="treeUnidades" "show-tree"="true" parentkey="superior" key="sys_pk" "hidde-selector"="true" style="width: 100%;" "control-styles"="tr td{font-size:.8rem;} th{font-size:.9rem; outline: none !important; font-weight:500 !important;} #__table_input{ font-size: unset !important; }" data='#<to.json(unidades)>')
							{
								"edit-thead"
								{
									"edit-tr"
									{
										"edit-th"(type="NoEditable" field="descripcion" style="text-align:start;"){$"Unidades organizacionales"}
									}
								}
							}
						}
					}
				}
				div(id="ajust_panel_unidad"){ $"" }
			}

			// Panel derecho
			div(id="content_container" class="section-container")
			{
				// Presupuesto
				section(class="border-bottom bg-white" id="header")
				{
					// Barra de controles
					div(class="d-flex flex-wrap justify-content-between align-items-center border-bottom")
					{
						div
						{
							button(id="tab_unidades" onclick="editor.toggleTabUnidades()" class="btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow"){
								svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#000" class="bi bi-list" viewBox="0 0 16 16"){
									path("fill-rule"="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5")
								}
								h6(class="m-0" id="unidad_selected"){$""}
							}
						}
						
						div(class="d-flex align-items-center gap-2" id="presupuesto_controls")
						{
							// table tabs
							div(class="d-flex justify-content-end align-items-center my-1 d-none" id="table_tabs")
							{
								div(style="background-color:var(--color-gray); padding: 4px;")
								{
									button(class="btn btn-sm text-secondary no-shadow btn-tab py-0 induxsoft-corners" id="btn_tab_subunidades" table="unidades_main_container"){$"Resumen"}
									button(class="btn btn-sm text-secondary no-shadow btn-tab py-0 induxsoft-corners" id="btn_tab_presupuesto" table="partidas_main_container"){$"Presupuesto"}
								}
							}

							div(class="d-flex flex-wrap align-items-center gap-1" id="presupuesto_actions")
							{
								a(href="#" id="btn_seguimiento_presupuesto" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-shadow no-print hidde-control"){"Seguimiento"}

								div(class="d-flex align-items-center justify-content-start gap-1 my-1")
								{
									button(id="btn_activar" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-shadow no-print hidde-control"){"Activar"}
									button(id="btn_detener" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-shadow no-print hidde-control"){"Detener"}
									button(id="btn_cerrar" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-shadow no-print hidde-control"){"Cerrar"}
								}

								button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control" title="Editar presupuesto" id="edit_pre" "data-bs-toggle"="modal" "data-bs-target"="#modal_presupuesto"){$"#<@ICON_EDIT>"}
								button(class="control btn btn-sm d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control" title="Eliminar presupuesto" id="delete_pre" onclick="editor.deletePresupuesto()"){$"#<@ICON_TRASH>"}
							}

							div(class="d-flex align-items-center gap-1")
							{
								small(class="fz-8 text-secondary"){$"Ejercicio:"}
								select(class="induxsoft-form-select fz-7" id="ejercicio_select")
								{
									#!
									ref years = get_year_list()
									for i = 0; i < list.count(years) {
										y = list.num(years,i)
										#$ option(value="#<y>" "#<ifstr(current_year != y,'', 'selected')>"=""){$"#<y>"}
									}
								}
							}
						}
					}
					// Información del presupuesto
					div(class="py-2 px-3 d-flex gap-2 flex-wrap" id="presupuesto_container")
					{
						small(class="text-secondary"){$"Selecciona una Unidad Organizacional."}
					}
				}

				section(id="content")
				{
					// Presupuestos (vista de tarjetas)
					div(class="row gx-2 gy-2 p-2" id="presupuestos"){$""}
					// Partidas
					div(class="d-none" id="partidas")
					{
						// Tables
						div(class="" id="tables")
						{
							// Table partidas
							div(id="partidas_main_container" class='t-table d-none')
							{
								// Barra de controles
								div(class="d-flex flex-wrap align-items-center justify-content-between border-bottom bg-white py-1 px-2")
								{
									div(class="d-flex align-items-center")
									{
										div(class="d-flex align-items-center justify-content-start gap-1" id="partida_info")
										{
											span(class="fw-bold" id="pda_title"){$"Item"}
											small(class="" id="pda_status_text"){$""}
											
											button(class="btn btn-link rounded-0 no-shadow py-0 px-1 hidde-control" id="pda_detail"){$"Detalle"}
										}

										small(class="text-muted mx-2"){$"|"}

										div(class="d-flex align-items-center justify-content-start hidde-control" id="table_partidas_control")
										{
											##
											btn_table_cls = "control btn btn-sm btn-main-action d-flex align-items-center justify-content-center gap-2 p-1 no-shadow"
											##

											button(class="#<btn_table_cls>" title="Disminuir identación" onclick="editor.indentPartidaRow(false)"){$"#<@ICON_TEXT_INDENT_RIGHT>"}
											button(class="#<btn_table_cls>" title="Agregar identación" onclick="editor.indentPartidaRow(true)"){$"#<@ICON_TEXT_INDENT_LEFT>"}
											button(class="#<btn_table_cls>" title="Eliminar fila" onclick="editor.deleteRowPartida()"){$"#<@ICON_REMOVE_ROW>"}
											button(class="#<btn_table_cls>" title="Agregar fila" onclick="editor.addRowPartida()"){$"#<@ICON_ADD_ROW>"}
											button(class="#<btn_table_cls>" title="Insertar fila" onclick="editor.insertRowPartida()"){$"#<@ICON_INSERT_ROW>"}
											button(class="#<btn_table_cls>" title="Agregar fila hermana" onclick="editor.addRowBroPartida()"){$"#<@ICON_ADD_ROW_BRO>"}
											button(class="#<btn_table_cls>" title="Agregar fila hija" onclick="editor.addRowSonPartida()"){$"#<@ICON_ADD_ROW_SON>"}
										}

										div(class="d-flex align-items-center justify-content-start gap-1" id="status_partidas_control")
										{
											button(class="#<btn_table_cls>" title="Transferir partida" onclick="editor.showTransferPartidaModal()"){$"#<@ICON_TRANSFER_ROW>"}

											##
											btn_status_cls = "btn btn-xs btn-main-action btn-status border-secondary rounded-0 no-shadow hidde-control"
											##

											button(class="#<btn_status_cls>" id="pda_prevista" status="#<@stt_pda_prevista>" onclick="editor.changePartidaStatus(this)"){$"Prevista"}
											button(class="#<btn_status_cls>" id="pda_revision" status="#<@stt_pda_revision>" onclick="editor.changePartidaStatus(this)"){$"En revisión"}
											button(class="#<btn_status_cls>" id="pda_revisada" status="#<@stt_pda_revisada>" onclick="editor.changePartidaStatus(this)"){$"Revisada"}
											button(class="#<btn_status_cls>" id="pda_autorizar" status="#<@stt_pda_autorizada>" onclick="editor.changePartidaStatus(this)"){$"Autorizar"}
											button(class="#<btn_status_cls>" id="pda_cancelar" status="#<@stt_pda_cancelada>" onclick="editor.changePartidaStatus(this)"){$"Cancelar"}
										}
									}

									div(class="d-flex align-items-center justify-content-start" id="partidas_control")
									{
										button(class="control btn btn-sm btn-main-action d-flex align-items-center justify-content-center gap-2 no-shadow" title="Modificar partidas" id="enable_edit_partidas" onclick="editor.togglePartidasControl(true)"){
											$"#<@ICON_EDIT>"
											small{$"Modificar"}
										}
										button(class="control btn btn-sm btn-main-action d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control" title="Guardar cambios" id="save_pre" onclick="editor.savePartidasPresupuesto()"){
											$"#<@ICON_SAVE>"
											small{$"Guardar"}
										}
										button(class="control btn btn-sm btn-main-action d-flex align-items-center justify-content-center gap-2 no-shadow hidde-control" title="Descartar cambios" id="disc_pre" onclick="editor.discardPartidasPresupuesto()"){
											$"#<@ICON_DISCARD>"
											small{$"Descartar"}
										}
									}
								}
								// Tabla de partidas
								div(id="partidas_container")
								{
									div(style="max-height:80vh; display:flex;")
									{
										"edit-table"(id="treePartidas" style="width:100%;" readonly="" "show-tree"="true" parentkey="padre" key="sys_pk" "can-move-row"="true" "control-styles"="tr th{ font-size:.9rem; outline:none !important; font-weight:500 !important; } tr td{ font-size:.8rem; } table{ background-color:#FFF !important; } #__table_input{ font-size: unset !important; }tbody tr:hover{background-color:#EDEDED;}")
										{
											"edit-thead"
											{
												"edit-tr"
												{
													"edit-th"(type="Text" field="partida"){$"Partida"}
													"edit-th"(type="Number" field="autorizado" allow="#<@('#./autedt')>" "default"="0" "textalign"="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Autorizado"}
													"edit-th"(type="NoEditable" field="anual" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Anual"}
													"edit-th"(type="Number" field="reserva" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true" "textalign"="end"){$"Reserva"}

													"edit-th"(type="Number" field="p01" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Enero"}
													"edit-th"(type="Number" field="p02" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Febrero"}
													"edit-th"(type="Number" field="p03" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Marzo"}
													"edit-th"(type="Number" field="p04" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Abril"}
													"edit-th"(type="Number" field="p05" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Mayo"}
													"edit-th"(type="Number" field="p06" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Junio"}
													"edit-th"(type="Number" field="p07" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Julio"}
													"edit-th"(type="Number" field="p08" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Agosto"}
													"edit-th"(type="Number" field="p09" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Septiembre"}
													"edit-th"(type="Number" field="p10" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Octubre"}
													"edit-th"(type="Number" field="p11" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Noviembre"}
													"edit-th"(type="Number" field="p12" "default"="0" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Diciembre"}

													"edit-th"(type="Memo" field="notas"){$"Notas"}
												}
											}
										}
									}
								}
							}
							// Table sub unidades
							div(id="unidades_main_container" class='t-table d-none')
							{
								// Barra de controles
								div(class="p-2 d-flex flex-wrap align-items-center justify-content-between border-bottom bg-white")
								{
									small(class="fw-5"){$"Resumen"}
								}
								// Tabla de sub unidades
								div
								{
									div(style="max-height: 80vh;display: flex;")
									{
										"edit-table"(id="tableSubUnids" style="width: 100%;" "control-styles"="tr td{font-size:.8rem;} th{font-size:.9rem; outline: none !important;} table{ background-color:#FFF !important; } #__table_input{ font-size: unset !important; } tbody tr:hover{background-color:#EDEDED;}")
										{
											"edit-thead"
											{
												"edit-tr"
												{
													"edit-th"(type="NoEditable" field="unidad_desc"){$"Unidad"}
													"edit-th"(type="NoEditable" field="pres_title"){$"Presupuesto"}
													"edit-th"(type="NoEditable" field="ejercicio" textalign="center"){$"Ejercicio"}
													"edit-th"(type="NoEditable" field="status" textalign="center"){$"Estado"}
													"edit-th"(type="NoEditable" field="divisa" textalign="center"){$"Divisa"}
													"edit-th"(type="Number" field="monto_autorizado" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Monto autorizado"}
													"edit-th"(type="Number" field="monto_planeado" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Monto planeado"}
													"edit-th"(type="Number" field="monto_comprometido" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Monto comprometido"}
													"edit-th"(type="Number" field="monto_ejercido" textalign="end" format="true" decs="2" prefix="$" thousandssep="true"){$"Monto ejercido"}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				section(id="footer")
				{
					div(id="partidas_resumen" class="d-none align-items-center justify-content-between border-top bg-white py-1 px-2")
					{
						div(class="")
						{
							small(class="d-block fw-5"){"Reserva:"}
							span(id="total_reserva"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Enero:"}
							span(id="total_p01"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Febrero:"}
							span(id="total_p02"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Marzo:"}
							span(id="total_p03"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Abril:"}
							span(id="total_p04"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Mayo:"}
							span(id="total_p05"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Junio:"}
							span(id="total_p06"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Julio:"}
							span(id="total_p07"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Agosto:"}
							span(id="total_p08"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Septiembre:"}
							span(id="total_p09"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Octubre:"}
							span(id="total_p10"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Noviembre:"}
							span(id="total_p11"){"$0.00"}
						}
						div(class="")
						{
							small(class="d-block fw-5"){"Diciembre:"}
							span(id="total_p12"){"$0.00"}
						}
					}
				}
			}
		}

		script(src="#<@JS_MAIN>"){$""}
		script(src="#<@JS_PRESUPUESTOS>"){$""}
		script(src="#<@JS_EDITOR>"){$""}
		script{$'
			editor.divisa_predet = #<to.json(dvsp)>;
			editor.services = #<to.json(@URL_SERVICES)>;
			editor.unidades = #<to.json(unidades)>;
			editor.currenty = #<current_year>;
			editor.view_detail_preg="#<@VIEW_DETAIL_PREG>";
			editor.url_gop_partida = "#<@GOP_PARTIDA>";
			editor.template_add=`#<@TEMPLATE_ADD>`;

			editor.stt_ppto_borrador=#<@stt_ppto_borrador>;
			editor.stt_ppto_detenido=#<@stt_ppto_detenido>;
			editor.stt_ppto_activo=#<@stt_ppto_activo>;
			editor.stt_ppto_cerrado=#<@stt_ppto_cerrado>;

			editor.stt_pda_prevista=#<@stt_pda_prevista>;
			editor.stt_pda_revision=#<@stt_pda_revision>;
			editor.stt_pda_revisada=#<@stt_pda_revisada>;
			editor.stt_pda_autorizada=#<@stt_pda_autorizada>;
			editor.stt_pda_cancelada=#<@stt_pda_cancelada>;
			editor.cfg_pda_status="#<@cfg_pda_status>";
			editor.cfg_pda_stt_color = #<to.json(@cfg_pda_stt_color)>;
		'}
	}
}