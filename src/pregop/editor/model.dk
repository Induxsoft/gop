#include "dkli.dkh"
#!
module ""
{
    @table_name = "rh_unidad_org"

    // =============== DIVISA
    function gop.obtenerDivisas(&db, &params)
    {
        sql = "SELECT * FROM divisa;"
		return dbr.list(db, sql, params)
    }

    // =============== GOP_PARTIDA
    @query_partida_presupuestal = "
    SELECT
        p.sys_pk,
        p.sys_guid,
        p.sys_recver,
        p.sys_dtcreated,
        p.sys_timestamp,
        p.ref_presupuesto,
        IFNULL(p.id,'') id,
        p.padre,
        p.partida,
        e.id AS istatus,
        e.const AS cstatus,
        IFNULL(p.autorizado,0) autorizado,
        IFNULL(p.reserva,0) reserva,
        IFNULL(p.p01,0) p01, IFNULL(p.p02,0) p02, IFNULL(p.p03,0) p03, IFNULL(p.p04,0) p04,
        IFNULL(p.p05,0) p05, IFNULL(p.p06,0) p06, IFNULL(p.p07,0) p07, IFNULL(p.p08,0) p08,
        IFNULL(p.p09,0) p09, IFNULL(p.p10,0) p10, IFNULL(p.p11,0) p11, IFNULL(p.p12,0) p12,
        IFNULL(notas,'') notas
    FROM gop_partida p
        INNER JOIN gop_partida_status e ON p.status = e.id
    WHERE #<conditions>
    "

    function gop.obtenerPartidas(&db, &params)
    {
        conditions = "IF(IFNULL(@presupuesto,'')='', true, P.ref_presupuesto=@presupuesto) ORDER BY p.padre, p.sys_pk"
        return dbr.list(db,ftext(@query_partida_presupuestal),params)
    }

    function gop.obtenerPartida(&db, &params)
    {
        sql = "SELECT * FROM gop_partida where #<@keyfield>=@_entity_id limit 1;"
        
        return dbr.rec(db, sql, params)
    }

    function gop.partida.changeStatusOfChildren(db,pk_partida,status)
    {
        new params
        {
            @"lastuser": @@(@http_context,"$session/user/uid")
            @"padre": pk_partida
            @"status": status
        }
        ref children = dbr.list(db,"SELECT sys_pk FROM gop_partida WHERE padre = @padre",params)
        for i = 0; i < list.count(children)
        {
            params<"child"> : @@(list.obj(children,i),"#sys_pk")
            sql = "
            UPDATE gop_partida SET
                sys_timestamp = NOW(),
                sys_lastuser = @lastuser,
                sys_recver = (IFNULL(sys_recver,0) + 1),
                status = @status
            WHERE sys_pk = @child"
            do dbr.execute(db,sql,params)

            do gop.partida.changeStatusOfChildren(db,@@(params,"#child"),@@(params,"#status"))
        }

        do _free(params)
        do _free(children)
    }

    function gop.partida.changeStatus(&db,&params,&data)
    {
        sql_partida = "
        SELECT
            pda.padre,
            pda.status,
            ppto.ref_unidad,
            (IFNULL(pda.re,0)+IFNULL(pda.e01,0)+IFNULL(pda.e02,0)+IFNULL(pda.e03,0)+IFNULL(pda.e04,0)+IFNULL(pda.e05,0)+IFNULL(pda.e06,0)+IFNULL(pda.e07,0)+IFNULL(pda.e08,0)+IFNULL(pda.e09,0)+IFNULL(pda.e10,0)+IFNULL(pda.e11,0)+IFNULL(pda.e12,0)) AS ejercido
        FROM gop_partida pda
            INNER JOIN gop_presupuesto ppto ON pda.ref_presupuesto = ppto.sys_pk
        WHERE pda.sys_pk=@_entity_id AND pda.ref_presupuesto=@presupuesto
        "
        ref entity = dbr.rec(db,sql_partida,params)

        ref action = @@(@cfg_pda_stt_color,"&"+@@(params,"$status"))
        if @@(params,"#status") < @@(entity,"#status") { ref action:@@(@cfg_pda_stt_color,"&"+@@(entity,"$status")) }

        if isnull(action) { do rise_error(500,"Acción no definida") }
        if @@(entity,"#padre") > 0 { do rise_error(500,"No es posible cambiar el estado, esta acción solo esta disponible para 'Partidas Raíz'.") }
        if not(allow_status(@cfg_pda_status,@@(entity,"#status"),@@(params,"#status"))) {
            do rise_error(500,"No es posible cambiar al estado indicado debido al estado en el que se encuentra actualmente.")
        }
        if @@(entity,"#status") == @stt_pda_autorizado && @@(entity,"#ejercido") > 0 {
            do rise_error(500,"No es posible cambiar al estado indicado debido a que ya se han realizado afectaciones al ejercido de la partida.")
        }
        
        params<"lastuser"> : @@(@http_context,"$session/user/uid")
        act_code = @@(action,"$code")+":DET060:"+@@(entity,"$ref_unidad")

        @use_transaction = @false

        do dbr.apps.action.pre(act_code)
        do dbr.begin(db)

        do gop.partida.changeStatusOfChildren(db,@@(params,"#_entity_id"),@@(params,"#status"))

        sql = "
        UPDATE gop_partida SET
            sys_timestamp = NOW(),
            sys_lastuser = @lastuser,
            sys_recver = (IFNULL(sys_recver,0) + 1),
            status = @status
        WHERE sys_pk = @_entity_id"
        do dbr.execute(db,sql,params)

        conditions = "p.sys_pk=@_entity_id AND p.ref_presupuesto=@presupuesto"
        ref entity:dbr.rec(db,ftext(@query_partida_presupuestal),params)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity

        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            if isset("@@_action_context"){ do dbr.apps.action.log() }
            do rise_error(last_error_code(),last_error())
        }
    }

    function gop.crearPartida(&db, &params, &data)
    {
        @use_transaction = @false
        do dbr.begin(db)

        ref res = entity.create(db,params,data)

        if trim(@@(data, "$padre")) != "" {
            do updateParent(db, @@(res, "#sys_pk"))
        }

        do dbr.commit(db)
        return res

        exception
    	{
            if dbr.in_transaction(db) { do dbr.rollback(db) }
    		do rise_error(500,last_error())
    	}
    }

    function gop.actualizarPartida(&db,&params,&data)
    {
        ref updateAsc = dbr.rec(db, "SELECT * FROM gop_partida p WHERE p.sys_pk=@sys_pk AND 
            (IF(IFNULL(@padre,'_')='_', false, @padre!=p.padre)
            OR IF(IFNULL(@autorizado,'_')='_', false, @autorizado!=p.autorizado)
            OR IF(IFNULL(@reserva,'_')='_', false, @reserva!=p.reserva)
            OR IF(IFNULL(@p01,'_')='_', false, @p01!=p.p01)
            OR IF(IFNULL(@p02,'_')='_', false, @p02!=p.p02)
            OR IF(IFNULL(@p03,'_')='_', false, @p03!=p.p03)
            OR IF(IFNULL(@p04,'_')='_', false, @p04!=p.p04)
            OR IF(IFNULL(@p05,'_')='_', false, @p05!=p.p05)
            OR IF(IFNULL(@p06,'_')='_', false, @p06!=p.p06)
            OR IF(IFNULL(@p07,'_')='_', false, @p07!=p.p07)
            OR IF(IFNULL(@p08,'_')='_', false, @p08!=p.p08)
            OR IF(IFNULL(@p09,'_')='_', false, @p09!=p.p09)
            OR IF(IFNULL(@p10,'_')='_', false, @p10!=p.p10)
            OR IF(IFNULL(@p11,'_')='_', false, @p11!=p.p11)
            OR IF(IFNULL(@p12,'_')='_', false, @p12!=p.p12)) LIMIT 1;", data)

        @use_transaction = @false
        do dbr.begin(db)

        ref res = entity.create(db,params,data)

        if not(isnull(updateAsc)) {
            do updateParent(db, @@(res, "#sys_pk"))
        }

        do dbr.commit(db)
        return res

        exception
    	{
            if dbr.in_transaction(db) { do dbr.rollback(db) }
    		do rise_error(500,last_error())
    	}
    }

    function gop.eliminarPartida(&db, &params)
    {
        @use_transaction = @false
        do dbr.begin(db)

        do deleteChilds(db, @@(params,"_entity_id"))
        do entity.delete(db, params)
        do dbr.commit(db)

        exception
    	{
            if dbr.in_transaction(db) { do dbr.rollback(db) }
    		do rise_error(500,last_error())
    	}
    }

    function updateParent(&db,childPK)
    {
        new prm { @"child": childPK }

        ref parent = dbr.rec(db ,"
            SELECT p1.sys_pk 
            FROM gop_partida p1 
                INNER JOIN gop_partida p2 ON p2.padre=p1.sys_pk 
            WHERE p2.sys_pk=@child LIMIT 1;", prm)

        if not(isnull(parent))
        {
            do dbr.execute(db, "
                UPDATE gop_partida parent
                    INNER JOIN (
                        SELECT p.padre, SUM(IFNULL(p.autorizado,0)) autorizado, SUM(IFNULL(p.reserva,0)) reserva,
                            SUM(IFNULL(p.p01,0)) p01, SUM(IFNULL(p.p02,0)) p02, SUM(IFNULL(p.p03,0)) p03, SUM(IFNULL(p.p04,0)) p04,
                            SUM(IFNULL(p.p05,0)) p05, SUM(IFNULL(p.p06,0)) p06, SUM(IFNULL(p.p07,0)) p07, SUM(IFNULL(p.p08,0)) p08,
                            SUM(IFNULL(p.p09,0)) p09, SUM(IFNULL(p.p10,0)) p10, SUM(IFNULL(p.p11,0)) p11, SUM(IFNULL(p.p12,0)) p12
                        FROM gop_partida p 
                        WHERE p.padre=@sys_pk GROUP BY p.padre)
                    childs ON parent.sys_pk=childs.padre
                SET parent.autorizado = childs.autorizado, parent.reserva = childs.reserva, 
                    parent.p01 = childs.p01, parent.p02 = childs.p02, parent.p03 = childs.p03, 
                    parent.p04 = childs.p04, parent.p05 = childs.p05, parent.p06 = childs.p06, 
                    parent.p07 = childs.p07, parent.p08 = childs.p08, parent.p09 = childs.p09, 
                    parent.p10 = childs.p10, parent.p11 = childs.p11, parent.p12 = childs.p12
                WHERE parent.sys_pk=@sys_pk", parent)
            
            do updateParent(db, @@(parent, "#sys_pk"))
        }
    }

    function deleteChilds(&db, parentPK)
    {
        new prm { @"pk": parentPK }

        ref childs = dbr.list(db, "SELECT sys_pk FROM gop_partida WHERE padre=@pk;", prm)
        
        if not(isnull(childs)) && list.count(childs) > 0
        {
            for i=0; i<list.count(childs)
            {
                ref child = list.obj(childs, i)
                do deleteChilds(db, @@(child, "#sys_pk"))
                do dbr.delete(db, "gop_partida", "sys_pk=@sys_pk", child)
            }
        }
    }

    // =============== GOP_PRESUPUESTO
    function gop.obtenerPresupuestos(&db, &params)
    {
        do dbr.apps.action.grant("GP11")

        query = "SELECT * FROM gop_presupuesto;"
        return dbr.list(db, query, params)

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }
    function gop.obtenerPresupuesto(&db, &params)
    {
        do dbr.apps.action.grant("GP11:DET060:"+@@(params,"$_entity_id"))

        if field.exist(params,"_key") { @keyfield = @@(params,"$_key") }

        sql = ftext("
        SELECT p.sys_pk, p.sys_recver, p.titulo, IFNULL(p.notas, '') notas, p.status, s.const status_text, p.divisa, d.codigo divisa_text, 
            IFNULL(p.monto_autorizado, 0) monto_autorizado, IFNULL(p.monto_planeado, 0) monto_planeado, 
            IFNULL(p.monto_comprometido, 0) monto_comprometido, IFNULL(p.monto_ejercido, 0) monto_ejercido
        FROM gop_presupuesto p
            INNER JOIN gop_presupuesto_status s ON p.status = s.id
            INNER JOIN divisa d ON p.divisa = d.sys_pk
        WHERE p.#<@keyfield>=@_entity_id 
            AND IF(IFNULL(@e,'')='', true, p.ejercicio=@e)
        LIMIT 1;")

        ref res = dbr.rec(db, sql, params)

        if isnull(res) { do rise_error(0, "Elemento no encontrado") }

        return res

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    function gop.crearPresupuesto(&db,&params,&data)
    {
        @use_transaction = @false
        do dbr.apps.action.pre("GP12")
        do dbr.begin(db)

        ref presupuesto = record.copy(data,"*")
        using presupuesto
        {
            @"sys_user": @@(@http_context,"$session/user/uid")
            @"status": @stt_ppto_borrador
            @"monto_autorizado": 0.00
            @"monto_planeado": 0.00
            @"monto_comprometido": 0.00
            @"monto_ejercido": 0.00
        }
        
        ref entity = entity.create(db,params,presupuesto)
        
        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        return entity
        
        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }

    function changeStatus(&db,&params,&data)
    {
        ref entity = dbr.rec(db,"SELECT status, ref_unidad FROM gop_presupuesto WHERE sys_pk = @_entity_id",params)

        new action
        {
            @"activar": "GP14:DET060:"+@@(entity,"$ref_unidad")
            @"cerrar": "GP15:DET060:"+@@(entity,"$ref_unidad")
            @"detener": "GP16:DET060:"+@@(entity,"$ref_unidad")
        }

        act_text = @@(data,"$act")

        if act_text == "activar" { params<"status"> : @stt_ppto_activo }
        if act_text == "cerrar" { params<"status"> : @stt_ppto_cerrado }
        if act_text == "detener" { params<"status"> : @stt_ppto_detenido }

        if @@(params,"#status") < @@(entity,"#status")
        {
            if @@(entity,"#status") == @stt_ppto_activo { act_text = "activar" }
            if @@(entity,"#status") == @stt_ppto_cerrado { act_text = "cerrar" }
            if @@(entity,"#status") == @stt_ppto_detenido { act_text = "detener" }
        }

        act_code = @@(action,act_text)

        if act_code == "" { do rise_error(500,"No es posible continuar. Acción '"+act_text+"'' no esta definida.") }
        if not(allow_status(@cfg_ppto_status,@@(entity,"#status"),@@(params,"#status"))) {
            do rise_error(500,"No es posible cambiar al estado indicado debido al estado en el que se encuentra actualmente.")
        }

        @use_transaction = @false

        do dbr.apps.action.pre(act_code)
        do dbr.begin(db)

        params<"lastuser"> : @@(@http_context,"$session/user/uid")

        sql = "
        UPDATE gop_presupuesto SET
            sys_timestamp = NOW(),
            sys_lastuser = @lastuser,
            sys_recver = (IFNULL(sys_recver,0) + 1),
            status = @status
        WHERE sys_pk = @_entity_id"
        do dbr.execute(db,sql,params)

        ref entity:gop.obtenerPresupuesto(db,params)
        
        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)
        
        return entity

        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            if isset("@@_action_context"){ do dbr.apps.action.log() }
            do rise_error(last_error_code(),last_error())
        }
    }

    function gop.actualizarPresupuesto(&db,&params,&data)
    {
        if @@(data,"$act")!="" { return changeStatus(db,params,data) }

        ref new_data = record.create()
        if field.exist(data,"sys_pk"){ new_data<"sys_pk">: @@(data,"#sys_pk") }
        if field.exist(data,"sys_recver"){ new_data<"sys_recver">: @@(data,"#sys_recver") }

        if field.exist(data,"titulo"){ new_data<"titulo">: @@(data,"$titulo") }
        if field.exist(data,"notas"){ new_data<"notas">: @@(data,"$notas") }
        if field.exist(data,"status"){ new_data<"status">: @@(data,"#status") }
        if field.exist(data,"divisa"){ new_data<"divisa">: @@(data,"#divisa") }

        if field.exist(data,"monto_autorizado"){ new_data<"monto_autorizado">: @@(data,"#monto_autorizado") }
        if field.exist(data,"monto_planeado"){ new_data<"monto_planeado">: @@(data,"#monto_planeado") }
        if field.exist(data,"monto_comprometido"){ new_data<"monto_comprometido">: @@(data,"#monto_comprometido") }
        if field.exist(data,"monto_ejercido"){ new_data<"monto_ejercido">: @@(data,"#monto_ejercido") }

        ref presu = dbr.rec(db,"SELECT status FROM gop_presupuesto WHERE sys_pk = @sys_pk",new_data)
        ref partidas = @null

        if @@(presu,"#status") == @stt_ppto_cerrado { do rise_error(500,"No es posible realizar cambios debido al estado en el que se encuentra actualmente.") }
        if field.exist(data,"partidas")
        {
            if @@(presu,"#status") == @stt_ppto_detenido { do rise_error(500,"No es posible realizar afectaciones debido al estado en el que se encuentra actualmente.") }

            ref partidas = from.json(to.json(@@(data,"&partidas")))
            do field.remove(data,"partidas")
            do changePkParentToGuid(partidas)
        }
        
        @use_transaction = @false

        do dbr.apps.action.pre("GP12")
        do dbr.begin(db)
        
        ref res = entity.update(db,params,new_data)

        if not(isnull(partidas))
        {
            pk_presupuesto = @@(res,"#sys_pk")
            // do removeAllPartidas(db, pk_presupuesto)
            do insertPartidas(db,partidas,pk_presupuesto)
        }
        
        do dbr.apps.action.pos(res)
        do dbr.commit(db)
        do dbr.apps.action.ext(res)
        
        return res
        
        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            if isset("@@_action_context"){ do dbr.apps.action.log() }
            do rise_error(last_error_code(),last_error())
        }
    }

    function gop.eliminarPresupuesto(&db, &params)
    {
        @use_transaction = @false

            do dbr.apps.action.pre("GP13")
        do dbr.begin(db)
        
            if field.exist(params, "_entity_id")
            {
                new prm { @"pk_presupuesto": @@(params, "#_entity_id") }
                do dbr.execute(db, "UPDATE gop_partida SET padre=NULL WHERE ref_presupuesto=@pk_presupuesto", prm)
                do dbr.execute(db, "DELETE FROM gop_partida WHERE ref_presupuesto=@pk_presupuesto;", prm)
            }
            do entity.delete(db, params)
        
            do dbr.apps.action.pos(params)
        do dbr.commit(db)
            do dbr.apps.action.ext(params)
        
        return @null

        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    function removeAllPartidas(&db, pk_presupuesto)
    {
        new prm { @"pk": pk_presupuesto }
        do dbr.execute(db, "UPDATE gop_partida SET padre=NULL WHERE ref_presupuesto=@pk", prm)
        do dbr.execute(db, "DELETE FROM gop_partida WHERE ref_presupuesto=@pk", prm)
    }
    
    function insertPartidas(&db, &partidas, pk_presupuesto)
    {
        if not(isnull(partidas)) && list.count(partidas) > 0
        {
            for i = 0; i < list.count(partidas)
            {
                ref partida = list.obj(partidas,i)
                /*
                 * Si tiene padre lo guardamos temporalmente en el campo info para
                 * asignarselo a todos en una sola consulta
                 */
                do field.remove(partida,"anual")
                _save = @true

                using partida
                {
                    @"sys_pk": @@(partida,"#sys_pk")
                    @"sys_info": @@(partida,"$padre")
                    @"sys_recver": @@(partida,"#sys_recver")
                    @"padre*": @null
                    @"ref_presupuesto": pk_presupuesto
                    @"id": ifempty(@@(partida,"$id"),@@(partida,"$sys_guid"))
                }

                if @@(partida,"#sys_pk") < 1
                {
                    do field.remove(partida,"sys_pk")
                    do field.remove(partida,"sys_guid")
                    partida<"sys_user"> : @@(@http_context,"$session/user/uid")
                    partida<"status"> : @stt_pda_prevista
                    partida<"autorizado"> : 0.00
                }
                else
                {
                    status = @@(partida,"#istatus")
                    
                    if status == @stt_pda_prevista { do field.remove(partida,"autorizado") }
                    else if status == @stt_pda_revision || status == @stt_pda_revisada
                    {
                        do field.remove(partida,"reserva")
                        do field.remove(partida,"rc")
                        do field.remove(partida,"re")
                        for periodo = 1; periodo <= 12
                        {
                            p = "p"+padleft(periodo,2,"0")
                            c = "c"+padleft(periodo,2,"0")
                            e = "e"+padleft(periodo,2,"0")
                            do field.remove(partida,p)
                            do field.remove(partida,c)
                            do field.remove(partida,e)
                        }
                    }
                    else if status == @stt_pda_autorizada || status == @stt_pda_cancelada { _save = @false }
                }

                if _save
                {
                    if field.exist(partida,"sys_guid") { do field.remove(partida,"sys_guid") }
                    if field.exist(partida,"sys_dtcreated") { do field.remove(partida,"sys_dtcreated") }
                    if field.exist(partida,"sys_timestamp") { do field.remove(partida,"sys_timestamp") }
                    if trim(@@(partida,"$sys_info"))=="" { do field.remove(partida,"sys_info") }
                    if field.exist(partida,"status") { do field.remove(partida,"status") }
                    if field.exist(partida,"istatus") { do field.remove(partida,"istatus") }
                    if field.exist(partida,"cstatus") { do field.remove(partida,"cstatus") }

                    do parseNumbersPartida(partida)
                    do dbr.save(db,"gop_partida",partida)
                }
            }

            new prm { @"presupuesto": pk_presupuesto }
            //do dbr.execute(db, "UPDATE gop_partida p SET p.padre=(SELECT p2.sys_pk FROM gop_partida p2 WHERE p2.sys_guid=p.sys_info LIMIT 1) WHERE p.ref_presupuesto=@presupuesto", prm)
            do dbr.execute(db, "
                UPDATE gop_partida p
                    INNER JOIN gop_partida p2 ON p2.sys_guid=p.sys_info 
                SET p.padre=p2.sys_pk
                WHERE p.ref_presupuesto=@presupuesto", prm)
            do dbr.execute(db, "UPDATE gop_partida p SET p.sys_info=NULL WHERE p.ref_presupuesto=@presupuesto", prm)
        }
    }
    function changePkParentToGuid(&partidas)
    {
        if not(isnull(partidas)) && list.count(partidas) > 0
        {
            for i = 0; i < list.count(partidas)
            {
                ref p = list.obj(partidas, i)
                if @@(p,"$sys_guid") == "" { p<"sys_guid">: uuid() }
                
                if field.exist(p, "padre") && trim(@@(p, "$padre")) != ""
                {
                    guid_padre = ""
                    for j = 0; j < list.count(partidas)
                    {
                        ref p2 = list.obj(partidas, j)
                        if @@(p, "$padre") == @@(p2, "$sys_pk") 
                        { 
                            guid_padre = @@(p2 ,"$sys_guid") 
                            break
                        }
                    }
                    p<"padre">: guid_padre
                }
            }
        }
    }
    function parseNumbersPartida(&partida)
    {
        if trim(@@(partida, "$autorizado")) != "" { partida<"autorizado">: @@(partida, "#autorizado") }
        if trim(@@(partida, "$reserva")) != "" { partida<"reserva">: @@(partida, "#reserva") }
        if trim(@@(partida, "$p01")) != "" { partida<"p01">: @@(partida, "#p01") }
        if trim(@@(partida, "$p02")) != "" { partida<"p02">: @@(partida, "#p02") }
        if trim(@@(partida, "$p03")) != "" { partida<"p03">: @@(partida, "#p03") }
        if trim(@@(partida, "$p04")) != "" { partida<"p04">: @@(partida, "#p04") }
        if trim(@@(partida, "$p05")) != "" { partida<"p05">: @@(partida, "#p05") }
        if trim(@@(partida, "$p06")) != "" { partida<"p06">: @@(partida, "#p06") }
        if trim(@@(partida, "$p07")) != "" { partida<"p07">: @@(partida, "#p07") }
        if trim(@@(partida, "$p08")) != "" { partida<"p08">: @@(partida, "#p08") }
        if trim(@@(partida, "$p09")) != "" { partida<"p09">: @@(partida, "#p09") }
        if trim(@@(partida, "$p10")) != "" { partida<"p10">: @@(partida, "#p10") }
        if trim(@@(partida, "$p11")) != "" { partida<"p11">: @@(partida, "#p11") }
        if trim(@@(partida, "$p12")) != "" { partida<"p12">: @@(partida, "#p12") }
    }

    // =============== GOP_PRESUPUESTO_STATUS
    function gop.obtenerEstadoPresupuestos(&db, &params)
    {
        query = "SELECT * FROM gop_presupuesto_status;"
        return dbr.list(db, query, params)
    }
    function gop.obtenerEstadoPresupuesto(&db, &params)
    {
        sql = ftext("SELECT * FROM gop_presupuesto_status where #<@keyfield>=@_entity_id limit 1;")
        return dbr.rec(db, sql, params)
    }
    function validatePrivileges(&db,&params,idpg,message)
    {
        if trim(idpg)==""{return}

        do dbr.apps.action.grant(idpg)

        exception{params<"message_pvg">:message + last_error()}
    }
    // =============== RH_UNIDAD_ORG
    function gop.obtenerUnidades(&db, &params)
    {
        if trim(@@(params,"$_entity_id"))==""
        {
            do dbr.apps.action.grant("GP10")
        }

        query = "SELECT * FROM rh_unidad_org;"
        ref res = record.create()
        if @add_others
        {
            res<"unidades*">: dbr.list(db, query, params)
            res<"status*">: dbr.list(db, 'SELECT * FROM gop_presupuesto_status where id not in(3,4);', @null)
            res<"divisa*">: dbr.list(db, 'SELECT * FROM divisa;', @null)
        }
        else
        {
            ref res = dbr.list(db, query, params)
        }
        return res
    }
    function gop.obtenerUnidad(&db, &params)
    {
        sql = "SELECT * FROM rh_unidad_org where sys_pk=@_entity_id limit 1;"
        ref res = dbr.rec(db, sql, params)

        if @@(params,"$details") == "true"
        {
            new prm {
                @"unidad_padre": @@(res, "#sys_pk")
                @"ejercicio": @@(params, "$ejercicio")
            }

            query = "
            SELECT
                u.sys_pk AS unidad_pk,
                IFNULL(u.superior,0) AS unidad_fk,
                IF(IFNULL(u.superior,0) > 0, u.descripcion, '') AS unidad_desc,
                p.titulo AS pres_title,
                s.const AS `status`,
                d.codigo AS `divisa`,
                IFNULL(p.monto_autorizado,0) AS monto_autorizado,
                IFNULL(p.monto_planeado,0) AS monto_planeado,
                IFNULL(p.monto_comprometido,0) AS monto_comprometido,
                IFNULL(p.monto_ejercido,0) AS monto_ejercido
            FROM gop_presupuesto p
                INNER JOIN gop_presupuesto_status s ON p.`status` = s.id
                INNER JOIN divisa d ON p.divisa = d.sys_pk
                INNER JOIN rh_unidad_org u ON p.ref_unidad = u.sys_pk
            WHERE u.sys_pk = @unidad_padre
                OR (u.superior = @unidad_padre AND IF(IFNULL(@ejercicio,'')='', TRUE, p.ejercicio = @ejercicio))
            ORDER BY u.sys_pk ASC
            "
            
            res<"subunidades*">: dbr.list(db, query, prm)
        }

        return res
    }
    function gop.actualizarUnidad(&db, &params, &data)
    {
        if @@(data, "$superior") == "" { data<"superior*">: @null }

        do dbr.update(db, "rh_unidad_org", data, "sys_pk=@sys_pk", data)
        ref res = entity.read(db,params)

        return res
    }
    function gop.eliminarUnidad(&db, &params)
    {
        @use_transaction = @false
        ref presupuestos = list.create()

        do dbr.begin(db)

        if field.exist(params, "_entity_id")
        {
            new prm { @"pk_unidad": @@(params, "#_entity_id") }

            // Eliminar relaciones y registros de todas las partidas de todos los presupuestos de la unidad
            do dbr.execute(db, "
                UPDATE gop_partida par
                    INNER JOIN gop_presupuesto pre ON par.ref_presupuesto = pre.sys_pk
                    INNER JOIN rh_unidad_org uni ON pre.ref_unidad = uni.sys_pk
                SET par.padre=NULL WHERE uni.sys_pk=@pk_unidad", prm)

            do dbr.execute(db, "
                DELETE par FROM gop_partida par
                    INNER JOIN gop_presupuesto pre ON par.ref_presupuesto = pre.sys_pk
                    INNER JOIN rh_unidad_org uni ON pre.ref_unidad = uni.sys_pk
                WHERE uni.sys_pk=@pk_unidad;", prm)

            // Eliminar todos los presupuestos de la unidad
            do dbr.execute(db, "
                DELETE pre FROM gop_presupuesto pre
                    INNER JOIN rh_unidad_org uni ON pre.ref_unidad = uni.sys_pk
                WHERE uni.sys_pk=@pk_unidad;", prm)
        }
        
        // Eliminar la unidad
        do deleteChilds(db, @@(params,"#_entity_id"))
        do entity.delete(db, params)
        
        do dbr.commit(db)
        return @null
        
        exception
    	{
            if dbr.in_transaction(db) { do dbr.rollback(db) }
    		do rise_error(500,last_error())
    	}
    }
    function deleteChilds(&db, parentPK)
    {
        new prm { @"pk": parentPK }

        ref childs = dbr.list(db, "SELECT sys_pk FROM rh_unidad_org WHERE superior=@pk;", prm)
        
        if not(isnull(childs)) && list.count(childs) > 0
        {
            for i=0; i<list.count(childs)
            {
                ref child = list.obj(childs, i)
                do deleteChilds(db, @@(child, "#sys_pk"))
                do dbr.delete(db, "rh_unidad_org", "sys_pk=@sys_pk", child)
            }
        }
    }

 
}