#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "divisa"
        {
            @table_name = "divisa"
            point @list to gop.obtenerDivisas
            break
        }
        case "gop_partida"
        {
            @table_name = "gop_partida"
            point @list to gop.obtenerPartidas
            point @read to gop.obtenerPartida
            point @create to gop.crearPartida
            point @update to gop.actualizarPartida
            point @delete to gop.eliminarPartida
            break
        }
        case "gop_presupuesto"
        {
            @table_name = "gop_presupuesto"
            point @list to gop.obtenerPresupuestos
            point @read to gop.obtenerPresupuesto
            point @create to gop.crearPresupuesto
            point @update to gop.actualizarPresupuesto
            point @delete to gop.eliminarPresupuesto

            switch @@(@http_context,"$request/get/_action")
            {
                case "lock"
                {
                    point @create to gop.presupuesto.lock
                    point @update to gop.presupuesto.lock
                    break
                }
                case "unlock"
                {
                    point @create to gop.presupuesto.unlock
                    point @update to gop.presupuesto.unlock
                    break
                }
                case "chklock"
                {
                    point @read to gop.presupuesto.chklock
                    break
                }
            }

            break
        }
        case "gop_presupuesto_status"
        {
            @table_name = "gop_presupuesto_status"
            point @list to gop.obtenerEstadoPresupuestos
            point @read to gop.obtenerEstadoPresupuesto
            break
        }
        case "rh_unidad_org"
        {
            @table_name = "rh_unidad_org"
            @add_others = @false
            point @list to gop.obtenerUnidades
            point @read to gop.obtenerUnidad
            point @update to gop.actualizarUnidad
            point @delete to gop.eliminarUnidad
            break
        }
        case "change-pda-status"
        {
            point @create to gop.partida.changeStatus
            point @update to gop.partida.changeStatus
            break
        }
        case "transfer-partida"
        {
            point @create to gop.partida.transferirPartida
            point @update to gop.partida.transferirPartida
            
            @table_name = "gop_partida"
            break
        }
        default
        {
            @table_name = "rh_unidad_org"
            @add_others = @true
            point @list to gop.obtenerUnidades
            point @read to gop.obtenerUnidad
            @form_view = "form.dk"
            @list_view = "editor.dk"
            break
        }
    }
}