#include "dkli.dkh"
#!
module ":pregop"
{
    /**
    * Devuelve el nombre del campo en la tabla de la 
    * base de datos que le corresponde según el periodo
    * y clase de monto.
    *
    * string clase_monto | Valores posibles='presupuestado' o 'p','comprometido' 'c' o bien, 'ejercido' o 'e' (no es sensible a mayúsculas).
    * int periodo | Mes del que se obtendran los importes, valores menores o mayores al intervalo 1...12 se consideran la reserva.
    */
    partida.datafield::clase_monto,periodo
    {
        clase_monto=tolower(trim(clase_monto))
        if clase_monto=="presupuestado" { clase_monto="p"}
        if clase_monto=="comprometido" { clase_monto="c"}
        if clase_monto=="ejercido" { clase_monto="e"}

        if clase_monto=="p" && periodo>12 || periodo<1 { return "reserva" }
        if clase_monto=="c" && periodo>12 || periodo<1 { return "rc" }
        if clase_monto=="e" && periodo>12 || periodo<1 { return "re" }

        return clase_monto+format(periodo,"00")
    }
    /**
    * Obtener los importes del presupuesto de la partida indicada.
    *
    * int pda_sys_pk | Clave primaria de la partida.
    * int periodo | Mes del que se obtendran los importes.
    */
    partida.importes::&db, pda_sys_pk, periodo
    {
        namespace "pregop"

        new params { @"pda_sys_pk": parse.num(pda_sys_pk) }

        p_field=partida.datafield("p",periodo)
        c_field=partida.datafield("c",periodo)
        e_field=partida.datafield("e",periodo)

        sql_obtener_importes = "
        SELECT
            IFNULL(pda.#<p_field>,0) AS presupuestado,
            IFNULL(pda.#<c_field>,0) AS comprometido,
            IFNULL(pda.#<e_field>,0) AS ejercido,
            (IFNULL(pda.#<p_field>,0) - IFNULL(pda.#<c_field>,0) - IFNULL(pda.#<e_field>,0)) AS disponible
        FROM gop_partida AS pda
        WHERE pda.sys_pk = @pda_sys_pk
        "

        return dbr.rec(db, ftext(sql_obtener_importes), params)
    }

    /**
    * Afectar los monto presupuestado, comprometido o ejercido de la partida en el periodo indicado.
    *
    * int pda_sys_pk | Clave primaria de la partida.
    * int periodo | Mes sobre el que se hara la afectación.
    * registro montos | Referencia a un registro que contiene los montos de la afectación.
    *
    * ```dkl
    * new montos
    {
        @"presupuestado": 0.00 //(decimal) Monto (+\-) de la afectación.
        @"comprometido": 0.00 //(decimal) Monto (+\-) de la afectación.
        @"ejercido": 0.00 //(decimal) Monto (+\-) de la afectación.
    }
    * ``` 
    * Para incrementarlos usar un número positivo, para disminuirlos un número negativo
    */
    partida.afectar::&db, pda_sys_pk,periodo, &montos
    {
        namespace "pregop"

        sql_partida = "
        SELECT
            pda.sys_pk,
            IFNULL(pda.padre,0) padre,
            IFNULL((select ifnull(count(sys_pk),0) from gop_partida where padre=pda.sys_pk),0) hijos,
            pda.ref_presupuesto
        FROM gop_partida AS pda
            INNER JOIN gop_presupuesto AS ppto ON pda.ref_presupuesto = ppto.sys_pk
        WHERE pda.sys_pk = @pda_sys_pk AND ppto.status = 3
        "

        new params
        {
            @"pda_sys_pk": parse.num(pda_sys_pk)
        }

        new data {}

        if @@(montos,"#presupuestado")!=0 { data<partida.datafield("p",periodo)+"*">:dbr.sql("ifnull("+partida.datafield("p",periodo)+",0)+"+@@(montos,"$presupuestado"))}
        if @@(montos,"#comprometido")!=0 { data<partida.datafield("c",periodo)+"*">:dbr.sql("ifnull("+partida.datafield("c",periodo)+",0)+"+@@(montos,"$comprometido"))}
        if @@(montos,"#ejercido")!=0 { data<partida.datafield("e",periodo)+"*">:dbr.sql("ifnull("+partida.datafield("e",periodo)+",0)+"+@@(montos,"$ejercido"))}

        ref partida=dbr.rec(db,sql_partida,params)

        if isnull(partida) { do rise_error(0,ftext("Partida no encontrada, compruebe Id de la partida y estado del presupuesto")) }

        if not(dbr.in_transaction(db)) { do rise_error(0,"No se pueden afectar partidas fuera del contexto de una transacción de bases de datos")}
        
        if @@(montos,"#_levels")<1 && @@(partida,"#hijos")>0 { do rise_error(0,"No se puede afectar una partida que tiene sub-partidas de forma directa")}

        im_first=@@(montos,"#_levels")<1

        using params
        {
            @"sys_pk": @@(partida,"#sys_pk")
            @"padre": @@(partida,"#padre")
            @"presupuesto": @@(partida,"#ref_presupuesto")
        }

        do dbr.update(db, "gop_partida", data, "sys_pk=@sys_pk", params)

        if @@(params,"#padre")!=0 
        { 
            montos<"_level">:@@(montos,"#_level")+1
            do partida.afectar(db, @@(params,"#padre"), periodo, montos)
        }

        if im_first
        {
            sql_totales = "
            select 
                ifnull(sum(ifnull(reserva,0)+ifnull(p01,0)+ifnull(p02,0)+ifnull(p03,0)+ifnull(p04,0)+ifnull(p05,0)+ifnull(p06,0)+ifnull(p07,0)+ifnull(p08,0)+ifnull(p09,0)+ifnull(p10,0)+ifnull(p11,0)+ifnull(p12,0)),0)
                    planeado,
                ifnull(sum(ifnull(rc,0)+ifnull(c01,0)+ifnull(c02,0)+ifnull(c03,0)+ifnull(c04,0)+ifnull(c05,0)+ifnull(c06,0)+ifnull(c07,0)+ifnull(c08,0)+ifnull(c09,0)+ifnull(c10,0)+ifnull(c11,0)+ifnull(c12,0)),0)
                    comprometido,
                ifnull(sum(ifnull(re,0)+ifnull(e01,0)+ifnull(e02,0)+ifnull(e03,0)+ifnull(e04,0)+ifnull(e05,0)+ifnull(e06,0)+ifnull(e07,0)+ifnull(e08,0)+ifnull(e09,0)+ifnull(e10,0)+ifnull(e11,0)+ifnull(e12,0)),0)
                    ejercido
            from gop_partida
            where padre is null
                and ref_presupuesto=@presupuesto;
            "
            
            ref d_totales=dbr.rec(db,sql_totales,params)
            d_totales<"presupuesto">:@@(params,"presupuesto")

            do dbr.execute(db,"update gop_presupuesto set 
                                monto_planeado=@planeado,
                                monto_comprometido=@comprometido,
                                monto_ejercido=@ejercido where sys_pk=@presupuesto;",d_totales)
        }

        return @true
    }

    /**
    * Afectar el monto presupuestado de la partida en el periodo indicado.
    *
    * int pda_sys_pk | Clave primaria de la partida.
    * int periodo | Mes sobre el que se hara la afectación.
    * decimal monto | Monto de la afectación.
    */
    partida.presupuestado::&db, pda_sys_pk, periodo, monto
    {
        namespace "pregop"

        new montos
        {
            @"presupuestado": monto
        }

        return partida.afectar(db, pda_sys_pk, periodo, montos)
    }

    /**
    * Afectar el monto comprometido de la partida en el periodo indicado.
    *
    * int pda_sys_pk | Clave primaria de la partida.
    * int periodo | Mes sobre el que se hara la afectación.
    * decimal monto | Monto de la afectación.
    */
    partida.comprometido::&db, pda_sys_pk, periodo, monto
    {
        namespace "pregop"

        new montos
        {
            @"comprometido": monto
        }

        return partida.afectar(db, pda_sys_pk, periodo, montos)
    }

    /**
    * Afectar el monto ejercido de la partida en el periodo indicado.
    *
    * int pda_sys_pk | Clave primaria de la partida.
    * int periodo | Mes sobre el que se hara la afectación.
    * decimal monto | Monto de la afectacioón.
    */
    partida.ejercido::&db, pda_sys_pk, periodo, monto
    {
        namespace "pregop"

        new montos
        {
            @"ejercido": monto
        }

        return partida.afectar(db, pda_sys_pk, periodo, montos)
    }

    /**
    * Afectar importes de la partida.
    *
    * db | Referencia a una conexión de base de datos abierta (recomendado: transacción de base de datos previamente iniciada).
    * params | Referencia a un registro que contiene los datos necesarios para realizar las afectaciones.
    * return bool
    *
    * ```dkl
    * new params
    {
        @"sys_pk":          //(int) Clave primaria de la partida.
        @"sys_guid":        //(string) GUID que puede usarse como clave primaria de la partida.
        @"partida_id":      //(string) Identificador de la partida.
        @"ejercicio":       //(int) Ejercicio (yyyy) del presupuesto de la partida *Solo si ha indicado `partida_id`.
        @"unidad_org":      //(string) Código de la unidad organizacional *Solo si ha indicado `partida_id`.
        @"referencia":      //(string) Referencia del elemento que realiza la afectación.
        @"periodo":         //(int) Mes (MM) sobre el que se hara la afectación.
        @"comprometido":    //(decimal) Monto (+\-) de la afectación.
        @"ejercido":        //(decimal) Monto (+\-) de la afectación.
        @"det":             //(string) Código DET (Data Element Type) del elemento que realiza la afectación.
        @"det_id":          //(int) Clave primaria del elemento que realiza la afectación.
        @"usuario":         //(string) UserId del usuario logueado que realiza la afectación.
        @"notas":           //(string) Descripción sobre el movimiento de afectación de presupuesto.
    }
    * ```
    */
    partida.movimiento::&db,&params
    {
        namespace "pregop"

        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        joins = ""
        conditions = "FALSE"

        if @@(params,"#sys_pk") > 0 { conditions = "pda.sys_pk = @sys_pk" }
        else if trim(@@(params,"$sys_guid")) != "" { conditions = "pda.sys_guid = @sys_guid" }
        else if trim(@@(params,"$partida_id")) != ""
        {
            joins = "
            INNER JOIN gop_presupuesto AS ppto ON pda.ref_presupuesto = ppto.sys_pk
            INNER JOIN rh_unidad_org AS uorg ON ppto.ref_unidad = uorg.sys_pk
            "

            conditions = "(pda.id = @partida_id AND ppto.ejercicio = @ejercicio AND uorg.codigo = @unidad_org)"
        }

        pda_sys_pk = dbr.num(db,ftext("SELECT pda.sys_pk FROM gop_partida AS pda #<joins> WHERE #<conditions>"),params)

        new gop_mov
        {
            @"ref_partida": pda_sys_pk
            @"referencia": trim(@@(params,"$referencia"))
            @"periodo": @@(params,"#periodo")
            @"comprometido": @@(params,"#comprometido")
            @"ejercido": @@(params,"#ejercido")
            @"dte": @@(params,"$det")
            @"dte_id": @@(params,"#det_id")
            @"usuario": @@(params,"$usuario")
            @"notas": trim(@@(params,"$notas"))
        }

        do dbr.save(db,"gop_mov",gop_mov)

        if @@(params,"#comprometido") != 0 {
            do partida.comprometido(db, pda_sys_pk, @@(params,"#periodo"), @@(params,"#comprometido"))
        }
        if @@(params,"#ejercido") != 0 {
            do partida.ejercido(db, pda_sys_pk, @@(params,"#periodo"), @@(params,"#ejercido"))
        }

        if start_transaction { do dbr.commit(db) }

        return @true

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            
            code = last_error_code()
            error = last_error()

            do rise_error(code,error)
        }
    }
}