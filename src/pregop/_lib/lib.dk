#include "dkli.dkh"
#!
module ""
{
    function between(value, min, max)
    {
        return value >= min && value <= max
    }

    function ifempty(s,d)
    {
        if trim(str(s)) == "" { return str(d) }
        return str(s)
    }

    function isempty(s)
    {
        return trim(str(s)) == ""
    }

    function isnum(n)
    {
        do eval(n)
        return @true
        exception { do pop_exception() }
        return @false
    }

    function allow_status(config, status, allow)
    {
        ref list = split(trim(str(config)),',')
        for i = 0; i < list.count(list)
        {
            ref kv = split(list.str(list,i),':')
            if trim(list.str(kv,0)) == str(status) && trim(list.str(kv,1)) == str(allow) { return @true }
        }
        return @false
    }
    current_url::hst
	{
        if not(isset("@http_context")) && isset("@crud_context")
        {
            ref @http_context=@("&http")
        }
        
		host=@@(@http_context,"request/headers/HTTP_HOST")
		protocol=ifstr(parse.bool(@@(@http_context,"request/headers/HTTPS")),"https","http")
		path=replace(field.dstr(@http_context,"request/headers/request_uri","/"),"\\","/")
		
		if hst{path=list.str(split(path,"?"),0)} 

		return protocol+"://"+path.concat(host,path)
	}
}