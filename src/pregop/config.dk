#include "dkli.dkh"
#!
module "config.dk"
{
    if not(isset("@http_context")) && isset("@crud_context") { ref @http_context = @@(@crud_context,"&http") }

    // Enumeración de posibles estados del presupuesto.
    @stt_ppto_borrador = 1
    @stt_ppto_detenido = 2
    @stt_ppto_activo = 3
    @stt_ppto_cerrado = 4
    // Enumeración de posibles estados de la partida
    @stt_pda_prevista = 1
    @stt_pda_revision = 2
    @stt_pda_revisada = 3
    @stt_pda_autorizada = 4
    @stt_pda_cancelada = 99
    // Configuración de transición de status para los `presupuestos`. "estado:permitido".
    @cfg_ppto_status = "1:3, 2:3, 3:2, 3:4, 4:3"
    // Configuración de transición de status de las `partidas presupuestales`. "estado:permitido".
    @cfg_pda_status = "1:2, 2:1, 2:3, 2:99, 3:2, 3:4, 3:99, 4:3"

    new @cfg_pda_stt_color
    {
        member @"1"
        {
            @"code": "GP1A"
            @"color": "#FFFFFF"
            @"text": "Prevista"
            @"class": "text-dark border"
        }
        member @"2"
        {
            @"code": "GP1B"
            @"color": "#FFC107"
            @"text": "En revisión"
        }
        member @"3"
        {
            @"code": "GP17"
            @"color": "#FFEF00"
            @"text": "Revisada"
            @"class": "text-dark"
        }
        member @"4"
        {
            @"code": "GP19"
            @"color": "#198754"
            @"text": "Autorizada"
        }
        member @"99"
        {
            @"code": "GP18"
            @"color": "#6C757D"
            @"text": "Cancelada"
        }
    }

    @default_max_rows = 250

    //[deprecated]
    @STATUS_APROBADO = 3
    @STATUS_CERRADO = 4
    @STATUS_POR_APROBAR = 2

    // _STATIC RESOURCES
    @CSS_EDITOR = "/$/pregop/css/editor.css"
    @CSS_MAIN = "/$/pregop/css/main.css"
    @JS_MAIN = "/$/pregop/js/main.js"
    @JS_PRESUPUESTOS = "/$/pregop/js/presupuestos.js"
    @JS_EDITOR = "/$/pregop/js/editor.js"
    @JS_PARTIDA = "/$/pregop/js/gop_partida.js"
    @JS_OPS = "/$/pregop/js/ops.js"
    
    @FORMAT_DET_PRES="$ #,#.00"
    @OPS_OPER="/!/pregop/ops/"
    @OPS_OPER_GOP="/!/pregop/ops/{id}/view.oper_gop/"
    @OPS_EDIT="/!/pregop/ops/{id}/"
    
    // _PACKAGE
    @URL_BUSCAR_UNIDAD = "/!/pregop/editor/?_view=rh_unidad_org&s=@search"
    @URL_BUSCAR_UNIDAD_ORG = "/!/cmpreq/requisiciones/?_view=buscar-unidad-org&search=@search"
	@URL_BUSCAR_PARTIDA_PRE = "/!/cmpreq/requisiciones/?_view=buscar-partida-pre&search=@search"

    @URL_BITACORA_PARTIDA = "/!/webshell/log/DET035/@detid/"

    new @URL_SERVICES
    {
        @"gop_partida": "/!/pregop/editor/@partida/gop_partida"
        @"gop_presupuesto": "/!/pregop/editor/@presupuesto/gop_presupuesto"
        @"gop_presupuestos": "/!/pregop/editor/?_view=gop_presupuesto"
        @"rh_unidad": "/!/pregop/editor/@unidad/rh_unidad_org"
        @"divisa": "/!/pregop/editor/?_view=divisa"
        @"gop_presupuesto_status": "/!/pregop/editor/?_view=gop_presupuesto_status"
        @"change_pda_status": "/!/pregop/editor/@partida/change-pda-status/?status=@status&presupuesto=@presupuesto"
    }

    @EDITOR = "/!/pregop/editor/"
    @GOP_PARTIDA = "/!/pregop/gop_partida/"
    @GOP_PARTIDA_LOG = "/!/pregop/gop_partida_log/"
    @GESTION = "/!/pregop/gestion/"
    @VIEW_DETAIL_PREG="/!/pregop/gestion/?parent={id}"
    @MODEL_EDITOR="pregop/editor/model.dk"

    @TEMPLATE_ADD='
    <!-- small class="text-secondary w-100">La unidad aún no cuenta con presupuesto</small -->
    <button class="btn btn-sm btn-primary py-1 d-flex align-items-center gap-2 my-3" data-bs-toggle="modal" data-bs-target="#modal_presupuesto">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
        </svg>
        Agregar presupuesto
    </button>
    '

    @TEMPLATE_ERROR_PVG='<div class="alert alert-danger">@message</div>'

    @NUM_EJERCICIO = 10

    new @meses
    {
        @"1":"Enero"
        @"2":"Febrero"
        @"3":"Marzo"
        @"4":"Abril"
        @"5":"Mayo"
        @"6":"Junio"
        @"7":"Junio"
        @"8":"Agosto"
        @"9":"Septiembre"
        @"10":"Octubre"
        @"11":"Noviembre"
        @"12":"Diciembre"
    }
    getMes::numMes
    {
        return @@(@meses,"$"+str(numMes))
    }
}