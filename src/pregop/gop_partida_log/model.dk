#include "dkli.dkh"
#!
module ":gop.partida.log"
{
    @table_name = "gop_partida_log"
    @keyfield = "sys_pk"

    @list_query = "
    SELECT
        DATE_FORMAT(sys_dtcreated,'%Y-%m-%d %H:%i:%s') AS created_at,
        usuario,
        nota
    FROM #<@table_name>
    WHERE NOT IFNULL(sys_deleted,0)
        AND ref_partida = @partida
    ORDER BY sys_dtcreated DESC
    LIMIT #<@default_max_rows>
    "
    @read_query = "
    SELECT
        DATE_FORMAT(sys_dtcreated,'%Y-%m-%d %H:%i:%s') AS created_at,
        usuario,
        nota
    FROM #<@table_name>
    WHERE #<@keyfield> = @_entity_id
    "

    list::&db,&params
    {
        if @@(params,"#limit") > 0 { @default_max_rows = @@(params,"#limit") }
        return entity.list(db,params)
    }

    create::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.begin(db)

        new nota
        {
            @"sys_user": @@(@http_context,"$session/user/uid")
            @"nota": trim(@@(data,"$nota"))
            @"usuario": @@(@http_context,"$session/user/name")
            @"ref_partida": @@(data,"#ref_partida")
        }
        ref reg = entity.create(db,params,nota)
        do gop.partida.log.notify(db,nota)

        do dbr.commit(db)
        return reg

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    update::&db,&params,&data
    {
        new nota
        {
            @"sys_lastuser": @@(@http_context,"$session/user/uid")
            @"nota": trim(@@(data,"$nota"))
            @"usuario": @@(@http_context,"$session/user/name")
            @"ref_partida": @@(data,"#ref_partida")
        }
        return entity.update(db,params,nota)
    }

    notify::&db,&nota
    {
        sql_partida = "
        SELECT pda.sys_pk, pda.sys_user, pda.status, pda.partida, ppto.titulo AS presupuesto, uni.descripcion AS unidad
        FROM gop_partida AS pda
            INNER JOIN gop_presupuesto AS ppto ON pda.ref_presupuesto = ppto.sys_pk
            INNER JOIN rh_unidad_org AS uni ON ppto.ref_unidad = uni.sys_pk
        WHERE pda.sys_pk = @ref_partida
        "
        ref partida = dbr.rec(db,sql_partida,nota)
        owner = @@(partida,"$sys_user")
        status = @@(partida,"#status")
        
        _notify = @false
        notif_to_user = ""

        sql_has_priv = "
        SELECT usr.username, itm.itemid, itm.`description`
        FROM tuser AS usr
            INNER JOIN user_usergroup_ AS ug ON ug.users=usr.sys_pk
            INNER JOIN `profile` AS pf ON ug.`groups`=pf.`usergroup`
            INNER JOIN sitem AS itm ON pf.item=itm.sys_pk
        WHERE #<conditions>
        LIMIT 1;
        "
        sql_ultima_nota = "
        SELECT log.sys_user, log.usuario, log.nota
        FROM gop_partida_log AS log
            INNER JOIN tuser AS usr ON log.sys_user = usr.userid
            INNER JOIN user_usergroup_ AS ug ON usr.sys_pk = ug.users
            INNER JOIN `profile` AS pf ON ug.`groups` = pf.`usergroup`
            INNER JOIN sitem AS itm ON pf.item = itm.sys_pk
        WHERE #<conditions>
        ORDER BY log.sys_dtcreated DESC
        LIMIT 1;
        "

        switch status
        {
            case @stt_pda_revision
            {
                _notify = parse.bool(dbr.vars.getd(db,"pregop_notif_07","true"))

                if not(_notify) { break }
                //GP1B - Establecer partida en Revisión
                //GP17 - Establecer partida Revisada
                if @@(nota,"$sys_user") == owner
                {
                    // Notificar al Revisor de la partida cuando la nota sea del creador
                    conditions = "itm.itemid = 'GP1B' AND log.sys_user != @sys_user"
                    ref ult_nota = dbr.rec(db,ftext(sql_ultima_nota),nota)
                    notif_to_user = @@(ult_nota,"$sys_user")
                }
                else
                {
                    conditions = "usr.userid = @sys_user AND itm.itemid = 'GP1B'"
                    is_reviewer = not(isnull(dbr.rec(db,ftext(sql_has_priv),nota)))
                    // Notificar al creador de la partida cuando la nota sea de un revisor
                    if is_reviewer { notif_to_user = owner }
                }
                break
            }
            case @stt_pda_revisada
            {
                _notify = parse.bool(dbr.vars.getd(db,"pregop_notif_08","true"))

                if not(_notify) { break }
                //GP17 - Establecer partida Revisada
                //GP19 - Establecer partida Autorizada
                conditions = "(itm.itemid = 'GP17' OR itm.itemid = 'GP19') AND log.sys_user != @sys_user"
                ref ult_nota = dbr.rec(db,ftext(sql_ultima_nota),nota)
                notif_to_user = @@(ult_nota,"$sys_user")
                break
            }
            case @stt_pda_autorizada
            {
                _notify = parse.bool(dbr.vars.getd(db,"pregop_notif_09","true"))

                if not(_notify) { break }
                //GP17 - Establecer partida revisada
                //GP19 - Establecer partida Autorizada
                conditions = "(itm.itemid = 'GP17' OR itm.itemid = 'GP19') AND log.sys_user != @sys_user"
                ref ult_nota = dbr.rec(db,ftext(sql_ultima_nota),nota)
                notif_to_user = @@(ult_nota,"$sys_user")
                break
            }
        }

        if not(_notify) { return }
        if notif_to_user=="" { return }

        ref notif_to = list.create()
        new user { @"user": notif_to_user }
        do list.add(notif_to,user)

        notif_title = "Nueva nota a partida presupuestal"
        notif_body = "Unidad: "+@@(partida,"$unidad")+"\r\n"+@@(partida,"$partida")
        notif_body = notif_body + "\r\n"+@@(nota,"$usuario")+"> "+ifstr(length(@@(nota,"$nota"))>50, cut(@@(nota,"$nota"),50)+"...", @@(nota,"$nota"))
        notif_href = path.concat(@GOP_PARTIDA,@@(partida,"$sys_pk")+"/")

        new notification
        {
            @"title": notif_title
            @"sender": "pregop"
            @"body": notif_body
            @"href": "/?go="+url_encode(notif_href)
            @"target": "_self"
            @"to*": notif_to
        }
        do dbr.notif.send(db,notification)
    }

    point @list to gop.partida.log.list
    point @create to gop.partida.log.create
    point @update to gop.partida.log.update
}