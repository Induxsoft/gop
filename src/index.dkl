#include "dkli.dkh"
#set "meta-xml-declaration" "<!DOCTYPE html>\r\n"

#!
module "web_page"
{
    #include "functions.dkh"
	#include "serialize.dkh"
	#include "webcl.dkh"
	#include "website.dkl"

	ref unidades = get_rh_unidad_org()

    #$ div
	{
		#! include path.concat(@path_modals, "editor.dk")
		#$ link(href="/_resources/css/editor.css" rel="stylesheet"){$""}

		div(id="main_container")
		{
			div(id="unidades_container" class="section-container")
			{
				div(style="background-color:var(--color-gray);")
				{
					div(class="d-flex flex-wrap justify-content-end")
					{
						button(class="btn btn-sm d-flex align-items-center justify-content-center gap-2" "data-bs-toggle"="modal" "data-bs-target"="#modal_add_unidades"){
							svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#888" class="bi bi-plus-lg" viewBox="0 0 16 16"){
								path("fill-rule"="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z")
							}
							small{$"Agregar"}
						}
						button(class="btn btn-sm d-flex align-items-center justify-content-center gap-2" onclick="editor.deleteUnidadSelected()"){
							svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#aaa" class="bi bi-trash-fill" viewBox="0 0 16 16"){
								path(d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z")
							}
							small{$"Eliminar"}
						}
					}
				}
				div(id="unidades_container_list")
				{
					div(style="max-height: 90vh;display: flex;")
					{
						"edit-table"(id="treeUnidades" "show-tree"="true" parentkey="superior" key="sys_pk" style="width: 100%;" "control-styles"="tr td{font-size:.8rem;} th{font-size:.9rem;}" data='#<to.json(unidades)>')
						{
							"edit-thead"
							{
								"edit-tr"
								{
									"edit-th"(type="Text" field="descripcion" style="text-align:start;"){$"Unidades organizacionales"}
								}
							}
						}
					}
				}
			}
			div(id="hader_container" class="section-container")
			{
				$"Presupuesto"
			}
			div(id="details_container" class="section-container")
			{
				$"Partidas"
			}
		}

		script(src="/_resources/js/editor.js"){$""}
		script{$'
			editor.services = #<to.json(@services)>;
			editor.unidades = #<to.json(unidades)>;
		'}
	}
}