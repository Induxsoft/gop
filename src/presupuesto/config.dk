#include "dkli.dkh"
#!
program
{
    // _STATIC RESOURCES
    @CSS_EDITOR = "/$/presupuesto/css/editor.css"
    @CSS_MAIN = "/$/presupuesto/css/main.css"
    @JS_MAIN = "/$/presupuesto/js/main.js"
    @JS_PRESUPUESTOS = "/$/presupuesto/js/presupuestos.js"
    @JS_EDITOR = "/$/presupuesto/js/editor.js"
    

    // _PACKAGE
    @URL_BUSCAR_UNIDAD = "/!/presupuesto/editor/?_view=rh_unidad_org&s=@search"

    new @URL_SERVICES
    {
        @"gop_partida": "/!/presupuesto/editor/@partida/gop_partida"
        @"gop_presupuesto": "/!/presupuesto/editor/@presupuesto/gop_presupuesto"
        @"rh_unidad": "/!/presupuesto/editor/@unidad/rh_unidad_org"
        @"divisa": "/!/presupuesto/editor/?view=divisa"
        @"gop_presupuesto_status": "/!/presupuesto/editor/?view=gop_presupuesto_status"
    }

    @EDITOR = "/!/presupuesto/editor/"
}